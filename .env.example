# Copy to `.env` to override defaults. Any unset key falls back to config.py.

# Comma-separated phone numbers (digits only).
# ALLOWED_SENDERS=14155552671,447911123456

# Queue / concurrency
# MAX_QUEUE_SIZE=3
# MAX_CONCURRENT_JOBS=2
# MAX_CONCURRENT_DOWNLOADS=3
# CONCURRENT_FRAGMENTS=4

# yt-dlp format selection
# DOWNLOAD_FORMAT=bestvideo+bestaudio/best
# FORMAT_SORT=res:1080

# Paths
# TEMP_DIR=temp
# SESSION_DB=session.db

# Retries / timeouts (seconds)
# DOWNLOAD_MAX_ATTEMPTS=3
# DOWNLOAD_RETRY_BACKOFFS=2,8
# DOWNLOAD_ATTEMPT_TIMEOUT=600
# JOB_TIMEOUT=1800
